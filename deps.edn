{:paths ["src"]
 ;; kotoba-lang/graphql (graphql-clj) is the pure SDL/query-parsing/
 ;; structural-validation/field-resolution-execution engine (ADR-2607172500):
 ;; this repo's kotobase.protocols.graphql wires that library's
 ;; host-injected resolver port (graphql.ports/IResolver) to
 ;; kotobase.query.bridge -- it does not reimplement any GraphQL parsing
 ;; or execution.
 ;;
 ;; kotobase-query (kotoba-lang/kotobase-query) is the ADR-2607172300
 ;; bridge that turns kotobase.store/IStore documents into a queryable
 ;; arrangement-backed Datalog database (kotobase.query.bridge/materialize
 ;; + q) -- this repo's resolvers call into it directly, same as the
 ;; sibling org-opencypher-cypher/org-w3-sparql-protocol repos.
 ;;
 ;; kotobase-query's own deps.edn pulls in kotobase (kotobase.store/local)
 ;; and arrangement (the 4-covering index + arrangement.datalog); arrangement
 ;; in turn pulls in prolly-tree/io-ipld (its commit!/CID-snapshot machinery,
 ;; unused by this bridge chain but required at namespace-load time), which
 ;; pull in io-multiformats/org-ietf-cbor. tools.deps resolves that whole
 ;; chain transitively from the two direct deps below for the JVM :test
 ;; alias. The nbb primary test path has no dependency resolver, so
 ;; bin/run_tests.cljs / CI clone every transitive dep by hand and list every
 ;; src dir on --classpath -- see the README's Develop/test section for the
 ;; exact command and kotobase-query's own README for why each hop is there.
 :deps {io.github.kotoba-lang/graphql
        {:git/sha "e423920ce5712a3278b558584eb5d9ac09493728"}
        io.github.kotoba-lang/kotobase-query
        {:git/sha "25da85adf8a4c2b4108b7c3b8af4f7c46d1ef310"}}
 ;; First-class runtime is nbb/cljs (repo-wide runtime priority):
 ;;   nbb --classpath "src:test:.deps/graphql/src:.deps/kotobase-query/src:.deps/kotobase/src:.deps/arrangement/src:.deps/prolly-tree/src:.deps/io-ipld/src:.deps/io-multiformats/src:.deps/org-ietf-cbor/src" bin/run_tests.cljs
 ;; The :test alias below is the :clj COMPAT suite only -- not the primary
 ;; execution path.
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
